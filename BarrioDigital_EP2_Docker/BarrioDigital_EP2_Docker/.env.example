# Credenciales de desarrollo local. Cambiar antes de publicar en cualquier servidor.
RABBITMQ_USER=barriodigital
RABBITMQ_PASSWORD=barriodigital-local
RABBITMQ_ERLANG_COOKIE=barriodigital-cluster-cookie-local
AZURE_TENANT_ID=f402d005-2163-4d89-a6cd-e07c25b973b2
AZURE_SPA_CLIENT_ID=d7f096c4-0ef5-4833-8def-e802ffd7314a
AZURE_API_CLIENT_ID=54bc913a-2f45-4e55-9eae-b30616a9f8d5
AZURE_BACKEND_SCOPE=api://54bc913a-2f45-4e55-9eae-b30616a9f8d5/OT.Create
AZURE_REQUIRED_SCOPE=OT.Create
CORS_ORIGINS=http://localhost:4200
# Vacío: misma URL del frontend. Para AWS apuntar al Gateway configurado con el BFF.
PUBLIC_API_URL=
QUEUE_TTL_MS=30000
DLQ_TTL_MS=604800000
DEMO_FAILURE_ENABLED=true

# --- Etapa Oracle en el EC2 (compose.oracle.yml) ---
# Clave SYS de la base Oracle XE local:
# ORACLE_ADMIN_PASSWORD=
# Esquemas (usuarios bd_catalog/bd_requests/bd_notify se crean solos):
# ORACLE_CATALOG_PASSWORD=
# ORACLE_REQUESTS_PASSWORD=
# ORACLE_NOTIFY_PASSWORD=
# Opcional: apuntar a una Oracle externa (OCI ADB u otra):
# ORACLE_JDBC_URL=jdbc:oracle:thin:@<host>:1521/<service>
# ORACLE_CATALOG_USER=bd_catalog
# ORACLE_REQUESTS_USER=bd_requests
# ORACLE_NOTIFY_USER=bd_notify
