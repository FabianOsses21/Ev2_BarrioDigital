{
  "info": {
    "name": "BarrioDigital EP2 Docker",
    "description": "Ejecutar manualmente según docs/PRUEBA_EP2.md. Entra requiere access token de Admin. Demo solo en Compose demo. Los pasos de notificación requieren esperar el procesamiento asíncrono.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 BFF público",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Demo-Role",
            "value": "{{demoRole}}"
          },
          {
            "key": "X-Demo-User",
            "value": "{{demoUser}}"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/api/public"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Catálogo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Demo-Role",
            "value": "{{demoRole}}"
          },
          {
            "key": "X-Demo-User",
            "value": "{{demoUser}}"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/api/catalog"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const list=pm.response.json(); if(list.length)pm.environment.set(\"tipoId\",list[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Crear trámite correcto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-Role",
            "value": "{{demoRole}}"
          },
          {
            "key": "X-Demo-User",
            "value": "{{demoUser}}"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/requests",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipoId\": \"{{tipoId}}\",\n  \"asunto\": \"Luminaria apagada en la plaza\",\n  \"descripcion\": \"El poste cercano al acceso principal está sin iluminación.\",\n  \"clienteEmail\": \"vecino@example.test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.environment.set(\"requestId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
